        "num_numeric_features": len(numeric_features),
        "embedding_dim": 32,
        "hidden_dim": 64,
        "num_layers": 2,
        "num_heads": 4,
        "dropout": 0.2,
        "time_steps": 30,
        "numeric_features": numeric_features,
        "target_col": "Target_Advance_Rate"
    },
    "lstm_advance_rate_model.pth"
)

print("Model and configuration saved successfully.")


