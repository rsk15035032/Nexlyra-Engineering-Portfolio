    )
)

r2 = r2_score(
    actuals_original,
    predictions_original
)

print("MAE :", mae)
print("RMSE:", rmse)
print("R²  :", r2)





import torch
import torch.nn as nn
import matplotlib.pyplot as plt


# ============================================================
# 1. MODEL
# ============================================================

class LSTMAttentionRegressor(nn.Module):

    def __init__(
        self,
        num_sensors,
        num_numeric_features,
        embedding_dim=32,
        hidden_dim=64,
        num_layers=2,
        num_heads=4,
        dropout=0.2
    ):
        super().__init__()

        # Sensor ID embedding
        self.sensor_embedding = nn.Embedding(
            num_sensors,
            embedding_dim
        )

        # Numerical features + sensor embedding
        input_size = (
            num_numeric_features +
            embedding_dim
        )

        # 2 LSTM layers
        self.lstm = nn.LSTM(
            input_size=input_size,
            hidden_size=hidden_dim,
            num_layers=num_layers,
            batch_first=True,
            dropout=dropout
        )

        # Multi-Head Self Attention
        self.attention = nn.MultiheadAttention(
            embed_dim=hidden_dim,
            num_heads=num_heads,
            dropout=dropout,
            batch_first=True
        )

        # Regression head
        self.fc = nn.Sequential(
            nn.Linear(hidden_dim, 32),
            nn.ReLU(),
            nn.Dropout(dropout),
            nn.Linear(32, 1)
        )

    def forward(self, x_numeric, x_sensor):

        # Sensor embedding
        sensor_emb = self.sensor_embedding(x_sensor)

        # Combine numerical features + sensor embedding
        x = torch.cat(
            [x_numeric, sensor_emb],
            dim=2
        )

        # LSTM
        lstm_out, _ = self.lstm(x)

        # Multi-Head Attention
        attention_out, _ = self.attention(
            lstm_out,
            lstm_out,
            lstm_out
        )

        # Last timestep
        context = attention_out[:, -1, :]

        # Regression output
        output = self.fc(context)

        return output.squeeze(1)


# ============================================================
# 2. CREATE MODEL
# ============================================================

model = LSTMAttentionRegressor(
    num_sensors=num_sensors,
    num_numeric_features=len(numeric_features),
    embedding_dim=32,
    hidden_dim=64,
    num_layers=2,
    num_heads=4,
    dropout=0.2
).to(device)

print(model)





# ============================================================
# 3. INITIALIZE WITH MSE LOSS
# ============================================================

criterion = nn.MSELoss()

optimizer = torch.optim.Adam(
    model.parameters(),
    lr=0.001
)





# ============================================================
# 4. SWITCH TO HUBER LOSS
# ============================================================

criterion = nn.HuberLoss(
    delta=1.0
)

optimizer = torch.optim.Adam(
    model.parameters(),
    lr=0.001
)

max_grad_norm = 1.0


x_numeric, x_sensor, y = next(iter(train_loader))

print("x_numeric:", x_numeric.dtype)
print("x_sensor :", x_sensor.dtype)
print("y        :", y.dtype)
print("prediction:", model(x_numeric, x_sensor).dtype)





# ============================================================
# 5. TRAIN FOR 20 EPOCHS
# ============================================================

num_epochs = 20

train_losses = []
val_losses = []

for epoch in range(num_epochs):

    # -------------------------
    # Training
    # -------------------------

    model.train()

    running_train_loss = 0.0

    for x_numeric, x_sensor, y in train_loader:

        x_numeric = x_numeric.to(device)
        x_sensor = x_sensor.to(device)
        y = y.to(device).float()

        optimizer.zero_grad()

        prediction = model(
            x_numeric,
            x_sensor
        )

        loss = criterion(
            prediction,
            y
        )

        loss.backward()

        # Gradient clipping
        torch.nn.utils.clip_grad_norm_(
            model.parameters(),
            max_norm=max_grad_norm
        )

        optimizer.step()

        running_train_loss += loss.item()

    train_loss = (
        running_train_loss /
        len(train_loader)
    )

    # -------------------------
    # Validation
    # -------------------------

    model.eval()

    running_val_loss = 0.0

    with torch.no_grad():

        for x_numeric, x_sensor, y in val_loader:

            x_numeric = x_numeric.to(device)
            x_sensor = x_sensor.to(device)
            y = y.to(device).float()

            prediction = model(
                x_numeric,
                x_sensor
            )

            loss = criterion(
                prediction,
                y
            )

            running_val_loss += loss.item()

    val_loss = (
        running_val_loss /
        len(val_loader)
    )

    train_losses.append(train_loss)
    val_losses.append(val_loss)

    print(
        f"Epoch [{epoch + 1:02d}/{num_epochs}] | "
        f"Train Loss: {train_loss:.6f} | "
        f"Val Loss: {val_loss:.6f}"
    )


#### Plot and save the loss curve


# ============================================================
# 6. PLOT TRAINING VS VALIDATION LOSS
# ============================================================

plt.figure(figsize=(10, 6))

plt.plot(
    range(1, num_epochs + 1),
    train_losses,
    label="Training Loss"
)

plt.plot(
    range(1, num_epochs + 1),
    val_losses,
    label="Validation Loss"
)

plt.xlabel("Epoch")
plt.ylabel("Huber Loss")
plt.title(
    "LSTM + Multi-Head Attention - Advance Rate"
)

plt.legend()
plt.grid(True)

plt.tight_layout()

plt.savefig(
    "lstm_advance_loss.png",
    dpi=300,
    bbox_inches="tight"
)

plt.show()


