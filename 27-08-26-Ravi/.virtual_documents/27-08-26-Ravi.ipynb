class TBMLSTMRegressor(nn.Module):

    def __init__(
        self,
        num_sensors,
        num_numeric_features,
        embedding_dim=32,
        hidden_dim=64,
        num_layers=2,
        dropout=0.2
    ):

        super().__init__()

        # Sensor embedding
        self.sensor_embedding = nn.Embedding(
            num_embeddings=num_sensors,
            embedding_dim=embedding_dim
        )

        # 3 numerical features + 32 sensor embedding
        lstm_input_size = (
            num_numeric_features + embedding_dim
        )

        self.lstm = nn.LSTM(
            input_size=lstm_input_size,
            hidden_size=hidden_dim,
            num_layers=num_layers,
            batch_first=True,
            dropout=dropout
        )

        # Regression output
        self.fc = nn.Linear(
            hidden_dim,
            1
        )

    def forward(
        self,
        x_numeric,
        x_sensor
    ):

        # [batch, 30]
        sensor_emb = self.sensor_embedding(
            x_sensor
        )

        # [batch, 30, 32]

        x = torch.cat(
            [x_numeric, sensor_emb],
            dim=2
        )

        # [batch, 30, 35]

        lstm_out, _ = self.lstm(x)

        # [batch, 30, 64]

        last_output = lstm_out[:, -1, :]

        # [batch, 64]

        output = self.fc(last_output)

        # [batch, 1]

        return output.squeeze(1)





num_sensors = df_ts["sensor_id"].nunique()

model = TBMLSTMRegressor(
    num_sensors=num_sensors,
    num_numeric_features=len(numeric_features),
    embedding_dim=embedding_dim,
    hidden_dim=hidden_dim,
    num_layers=num_layers,
    dropout=dropout
)

model = model.to(device)

print(model)





criterion = nn.SmoothL1Loss()

optimizer = torch.optim.Adam(
    model.parameters(),
    lr=0.001
)





num_epochs = 20

for epoch in range(num_epochs):

    # =========================
    # Training
    # =========================

    model.train()

    train_loss = 0.0

    for x_numeric, x_sensor, y in train_loader:

        x_numeric = x_numeric.to(device)
        x_sensor = x_sensor.to(device)
        y = y.to(device)

        optimizer.zero_grad()

        prediction = model(
            x_numeric,
            x_sensor
        )

        loss = criterion(
            prediction,
            y
        )

        loss.backward()

        optimizer.step()

        train_loss += loss.item()

    train_loss /= len(train_loader)


    # =========================
    # Validation
    # =========================

    model.eval()

    val_loss = 0.0

    with torch.no_grad():

        for x_numeric, x_sensor, y in val_loader:

            x_numeric = x_numeric.to(device)
            x_sensor = x_sensor.to(device)
            y = y.to(device)

            prediction = model(
                x_numeric,
                x_sensor
            )

            loss = criterion(
                prediction,
                y
            )

            val_loss += loss.item()

    val_loss /= len(val_loader)

    print(
        f"Epoch {epoch + 1:02d}/{num_epochs} | "
        f"Train Loss: {train_loss:.4f} | "
        f"Val Loss: {val_loss:.4f}"
    )





model.eval()

predictions = []
actuals = []

with torch.no_grad():

    for x_numeric, x_sensor, y in test_loader:

        x_numeric = x_numeric.to(device)
        x_sensor = x_sensor.to(device)

        prediction = model(
            x_numeric,
            x_sensor
        )

        predictions.extend(
            prediction.cpu().numpy()
        )

        actuals.extend(
            y.numpy()
        )





predictions = np.array(predictions).reshape(-1, 1)
actuals = np.array(actuals).reshape(-1, 1)

predictions_original = target_scaler.inverse_transform(
    predictions
).ravel()

actuals_original = target_scaler.inverse_transform(
    actuals
).ravel()





mae = mean_absolute_error(
    actuals_original,
