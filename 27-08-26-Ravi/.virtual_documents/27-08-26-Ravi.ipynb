from torch.utils.data import Dataset, DataLoader


class TBMTimeSeriesDataset(Dataset):

    def __init__(
        self,
        df,
        numeric_features,
        target_col="Is_Spoofed",
        time_steps=60
    ):
        self.numeric_data = torch.tensor(
            df[numeric_features].values,
            dtype=torch.float32
        )

        self.sensor_data = torch.tensor(
            df["sensor_id"].values,
            dtype=torch.long
        )

        self.target_data = torch.tensor(
            df[target_col].values,
            dtype=torch.long
        )

        self.time_steps = time_steps

    def __len__(self):
        return len(self.numeric_data) - self.time_steps

    def __getitem__(self, idx):

        # 60-minute numerical sequence
        x_numeric = self.numeric_data[
            idx:idx + self.time_steps
        ]

        # 60-minute sensor ID sequence
        x_sensor = self.sensor_data[
            idx:idx + self.time_steps
        ]

        # Target immediately after the sequence
        y = self.target_data[
            idx + self.time_steps
        ]

        return x_numeric, x_sensor, y


